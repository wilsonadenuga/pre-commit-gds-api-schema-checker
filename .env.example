# Copy to `.env` and fill in real values. `.env` is gitignored.
# Auto-loaded on CLI startup — no `source` or `export` needed. Shell env
# values win over `.env` values, so an inline `GDS_UPLIFT_NO_LLM=1 make demo`
# always overrides whatever is in this file.

# Required for the AI pass. The Anthropic SDK reads this from the environment.
# Get one at https://console.anthropic.com/. Skip if you only run --no-llm mode.
ANTHROPIC_API_KEY=

# Optional. When set to any truthy value ("1", "true", "yes"), the CLI's agent
# pass is disabled globally — deterministic findings still print, but no LLM
# call is made and no suggestions are generated. Equivalent to passing
# --no-llm on every invocation. Set this in CI where a stray key must never
# trigger billable calls.
GDS_UPLIFT_NO_LLM=
