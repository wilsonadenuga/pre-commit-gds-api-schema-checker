# Copy to `.env`. The AI pass uses your AWS credentials for Bedrock (e.g. after `aws sso login`).
AWS_REGION=eu-west-2
# AWS_PROFILE=your-profile   (leave commented out to use your default profile; an empty value breaks AWS login)
# Empty, 0, false or no = AI pass runs; any other value (e.g. 1, or even "off") = AI pass skipped
GDS_UPLIFT_NO_LLM=
